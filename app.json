{
  "expo": {
    "name": "EJR Mobile",
    "slug": "ejr-mobile",
    "version": "1.1.6",
    "scheme": "ejrmobile",
    "orientation": "portrait",
    "icon": "./assets/images/ejr_icon_ios.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.ejrgarage.ejrMobile",
      "supportsTablet": false,
      "associatedDomains": [
        "applinks:ejrgarage-staging.onrender.com"
      ]
    },
    "android": {
      "package": "com.ejrgarage.ejr_mobile",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/ejr_icon_foreground.png"
      },
      "permissions": [
        "CAMERA",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "ejrgarage-staging.onrender.com",
              "pathPrefix": "/reset-password.php"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/ejr_logo_splash.png",
          "imageWidth": 180,
          "backgroundColor": "#FDE8DC"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "EJR Mobile uses the camera so you can take a profile photo.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#ED5B1C"
        }
      ]
    ]
  }
}
